# ══════════════════════════════════════════════════════════════════════════════
# LinkedIn Profile API — Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# Two authentication modes are supported. Choose ONE:
#
# ── MODE A: Email + Password (recommended) ────────────────────────────────────
# The app authenticates with LinkedIn programmatically at startup.
# No browser is ever needed. Session is established via the reverse-engineered
# login flow and refreshed automatically.

LINKEDIN_EMAIL=your.email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ── MODE B: Raw session cookies (manual fallback) ─────────────────────────────
# Use this if Mode A is blocked by 2FA or a CAPTCHA challenge.
# How to get these:
#   1. Log in to linkedin.com in Chrome/Firefox
#   2. DevTools (F12) → Application → Cookies → www.linkedin.com
#   3. Copy the values for li_at and JSESSIONID
#
# Note: These expire after a few weeks and must be manually refreshed.
#
# LI_AT=your_li_at_cookie_value_here
# JSESSIONID="ajax:your_jsessionid_value_here"

# ── Optional settings ─────────────────────────────────────────────────────────

# Seconds between consecutive LinkedIn API calls (default: 0.5)
# Increase if you encounter rate limiting
# REQUEST_DELAY=0.5
